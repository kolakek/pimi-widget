<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <com.kolakek.pimiwidget.settings.WidgetPreviewPreference
        app:key="widget_style_preview" />

    <PreferenceCategory
        android:key="widget_style_list"
        android:title="@string/config_section_style"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/config_section_appearance"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="text_color_list"
            android:title="@string/config_text_color"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="widget_color_list"
            android:title="@string/config_color"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <com.kolakek.pimiwidget.settings.SliderPreference
            app:key="widget_transparency"
            app:title="@string/config_transparency" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
