<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <com.kolakek.pimiwidget.settings.WidgetPreviewPreference
        app:key="widget_style_preview" />

    <PreferenceCategory
        android:key="widget_style_list"
        android:title="@string/config_widget_style"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

    </PreferenceCategory>

    <PreferenceCategory
        app:key="widget_background_category"
        app:title="XXX"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <com.kolakek.pimiwidget.settings.SliderPreference
            app:key="widget_transparency"
            app:title="XXX" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
