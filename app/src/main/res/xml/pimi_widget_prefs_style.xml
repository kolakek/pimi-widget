<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <com.kolakek.pimiwidget.settings.WidgetPreviewPreference
        app:key="preview_widget" />

    <PreferenceCategory
        android:key="category_widget_style"
        android:title="@string/config_section_style"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_text_color"
        android:title="@string/config_text_color"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_widget_color"
        android:title="@string/config_section_color"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <com.kolakek.pimiwidget.settings.SliderPreference
            app:key="widget_transparency"
            app:title="@string/config_transparency"
            app:order="100" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
