<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.kolakek.pimiwidget.settings.MainSwitchPreference
        android:key="weather_switch"
        android:title="@string/config_weather_enable_switch"
        android:defaultValue="false" />

    <PreferenceCategory
        android:selectable="false"
        android:title="@string/config_section_general"
        app:iconSpaceReserved="false"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false">

        <Preference
            android:title="@string/config_weather_provider"
            android:summary="@string/config_weather_attribution_open_meteo"
            android:selectable="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="location_source_list"
            android:title="@string/config_weather_location"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="weather_app_default"
            android:entries="@array/weather_apps"
            android:entryValues="@array/weather_apps_vals"
            android:key="weather_app_list"
            android:title="@string/config_weather_app"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:selectable="false"
        android:title="@string/config_section_display"
        app:iconSpaceReserved="false"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false">

        <CheckBoxPreference
            android:key="weather_warnings"
            android:title="@string/config_weather_warnings"
            android:summary="@string/config_weather_warnings_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="daily_forecast"
            android:title="@string/config_daily_forecast"
            android:summary="@string/config_daily_forecast_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="temp_unit_auto"
            android:entries="@array/temp_units"
            android:entryValues="@array/temp_units_vals"
            android:key="temp_list"
            android:title="@string/config_temp_unit"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
