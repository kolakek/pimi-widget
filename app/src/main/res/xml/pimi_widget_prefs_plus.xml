<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="widget_style_list"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="location_fallback"
            android:title="@string/config_location_fallback"
            android:summary="@string/config_location_fallback_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="show_temp_unit"
            android:title="@string/config_show_temp_unit"
            android:summary="@string/config_show_temp_unit_descr"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="permanent_alarm"
            android:title="@string/config_perm_alarm"
            android:summary="@string/config_perm_alarm_descr"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="aux_view_list"
            android:title="@string/config_aux_view_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
