<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container">

    <LinearLayout style="@style/Widget.Row.Primary">

        <TextClock
            android:id="@+id/widget_date_text"
            style="@style/Widget.Date.Shadow"
            tools:ignore="TextContrastCheck" />

        <LinearLayout
            android:id="@+id/widget_alarm"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_alarm_icon"
                android:src="@drawable/ic_alarm_shadow"
                style="@style/Widget.EventIcon"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/widget_alarm_text"
                style="@style/Widget.Event.Shadow" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_birthday"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_birthday_icon"
                android:src="@drawable/ic_birthday_shadow"
                style="@style/Widget.EventIcon"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/widget_birthday_text"
                style="@style/Widget.Event.Shadow" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout style="@style/Widget.Row">

        <LinearLayout
            android:id="@+id/widget_weather"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_sync_icon"
                android:src="@drawable/ic_sync_shadow"
                style="@style/Widget.SyncIcon"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/widget_weather_icon"
                style="@style/Widget.WeatherIcon"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/widget_temp_text"
                style="@style/Widget.Temp.Classic.Shadow" />

        </LinearLayout>

        <TextView
            android:id="@+id/widget_aux_text"
            style="@style/Widget.Aux.Classic.Shadow" />

    </LinearLayout>

</LinearLayout>
