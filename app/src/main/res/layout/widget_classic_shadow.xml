<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container">

    <LinearLayout style="@style/Widget.Row.Primary">

        <TextClock
            android:id="@+id/date"
            style="@style/Widget.Date.Shadow"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/alarm"
            style="@style/Widget.Event.Shadow" />

        <TextView
            android:id="@+id/birthday"
            style="@style/Widget.Event.Shadow" />

    </LinearLayout>

    <LinearLayout style="@style/Widget.Row">

        <ImageView
            android:id="@+id/weather_icon"
            style="@style/Widget.WeatherIcon"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/weather_temp"
            style="@style/Widget.Temp.Classic.Shadow" />

        <TextView
            android:id="@+id/weather_aux"
            style="@style/Widget.Aux.Classic.Shadow" />

    </LinearLayout>

</LinearLayout>
