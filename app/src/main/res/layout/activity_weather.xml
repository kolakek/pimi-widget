<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.search.SearchBar
                android:id="@+id/place_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:hint="@string/config_fixed_location_search_open_meteo"
                android:textAppearance="@style/App.PlaceBarText"
                app:defaultMarginsEnabled="false"
                app:navigationIcon="@drawable/ic_location"
                app:tintNavigationIcon="false"
                app:menu="@menu/weather_place_bar"
                app:backgroundTint="?attr/colorSurfaceContainerHighest" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/App.SectionTitle"
                    android:text="@string/app_text_now" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/data_refresh_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="14sp"
                    android:drawablePadding="4dp" />

            </LinearLayout>

            <include
                android:id="@+id/current_weather"
                layout="@layout/weather_current" />

            <TextView
                style="@style/App.SectionTitle"
                android:text="@string/app_text_hourly_forecast"
                android:layout_marginTop="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hourly_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="8dp"
                android:background="@drawable/app_item_background"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                style="@style/App.SectionTitle"
                android:text="@string/app_text_daily_forecast"
                android:layout_marginTop="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/daily_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                style="@style/App.SectionTitle"
                android:text="@string/app_text_current_conditions"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/current_wind"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    layout="@layout/weather_condition" />

                <include
                    android:id="@+id/current_uv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/weather_condition" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/current_pressure"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    layout="@layout/weather_condition" />

                <include
                    android:id="@+id/current_humidity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    layout="@layout/weather_condition" />

            </LinearLayout>

            <include
                android:id="@+id/current_sun"
                layout="@layout/weather_sun" />

            <TextView
                style="@style/App.SectionTitle"
                android:text="@string/app_text_hourly_details"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <include
                android:id="@+id/hourly_details"
                layout="@layout/weather_hourly_details" />

            <TextView
                android:text="@string/config_weather_attribution_open_meteo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_error"
            android:adjustViewBounds="true"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/no_data_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/no_data_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/no_data_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <com.google.android.material.search.SearchView
        android:id="@+id/place_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/config_fixed_location_search_placeholder"
        app:layout_anchor="@id/place_bar">

    </com.google.android.material.search.SearchView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
