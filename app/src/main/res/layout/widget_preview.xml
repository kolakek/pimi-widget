<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Container.Solid.Frame">

    <ImageView
        style="@style/Widget.Background.Solid"
        tools:ignore="ContentDescription" />

    <LinearLayout style="@style/Widget.Container.Solid">

        <LinearLayout style="@style/Widget.Container.Inner.Vertical.Solid">

            <LinearLayout style="@style/Widget.Row.Primary">

                <TextView
                    style="@style/Widget.Date.Solid"
                    android:text="@string/widget_date_prev" />

            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Row.Secondary"
                tools:ignore="UseCompoundDrawables">

                <TextView
                    style="@style/Widget.Aux.Solid"
                    android:text="@string/widget_weather_prev" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout style="@style/Widget.Container.Weather.Solid">

            <ImageView
                style="@style/Widget.Background.Weather.Solid"
                tools:ignore="ContentDescription" />

            <LinearLayout
                style="@style/Widget.Container.Weather.Solid.Content"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    style="@style/Widget.WeatherIcon.Solid"
                    android:src="@drawable/wb_0d"
                    tools:ignore="ContentDescription" />

                <TextView
                    style="@style/Widget.Temp.Solid"
                    android:text="@string/widget_temp_prev" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
