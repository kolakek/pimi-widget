<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container.Solid.Frame">

    <ImageView
        android:id="@+id/widget_background"
        style="@style/Widget.Background.Solid"
        tools:ignore="ContentDescription" />

    <LinearLayout style="@style/Widget.Container.Solid">

        <LinearLayout style="@style/Widget.Container.Inner.Vertical.Solid">

            <LinearLayout style="@style/Widget.Row.Primary">

                <TextClock
                    android:id="@+id/widget_date_text"
                    style="@style/Widget.Date.Solid" />

                <LinearLayout
                    android:id="@+id/widget_alarm"
                    style="@style/Widget.Container.Inner.Horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/widget_alarm_icon"
                        android:src="@drawable/ic_alarm"
                        style="@style/Widget.EventIcon"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/widget_alarm_text"
                        style="@style/Widget.Event.Solid" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_birthday"
                    style="@style/Widget.Container.Inner.Horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/widget_birthday_icon"
                        android:src="@drawable/ic_birthday"
                        style="@style/Widget.EventIcon"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/widget_birthday_text"
                        style="@style/Widget.Event.Solid" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_aux"
                style="@style/Widget.Container.Inner.Horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/widget_warn_svr_icon"
                    android:src="@drawable/ic_warn_sevr"
                    style="@style/Widget.WarnIcon.Solid"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/widget_warn_xtr_icon"
                    android:src="@drawable/ic_warn_extr"
                    style="@style/Widget.WarnIcon.Solid"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/widget_aux_text"
                    style="@style/Widget.Aux.Solid" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout style="@style/Widget.Container.Weather.Solid">

            <ImageView
                android:id="@+id/widget_icon_background"
                style="@style/Widget.Background.Weather.Solid"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:id="@+id/widget_weather"
                style="@style/Widget.Container.Weather.Solid.Content"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/widget_sync_icon"
                    android:src="@drawable/ic_sync"
                    style="@style/Widget.SyncIcon"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    style="@style/Widget.WeatherIcon.Solid"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/widget_temp_text"
                    style="@style/Widget.Temp.Solid" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
