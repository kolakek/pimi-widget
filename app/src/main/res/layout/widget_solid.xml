<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container.Solid.Frame">

    <ImageView
        android:id="@+id/widget_background"
        style="@style/Widget.Background.Solid"
        tools:ignore="ContentDescription" />

    <LinearLayout style="@style/Widget.Container.Solid">

        <LinearLayout style="@style/Widget.Container.Inner.Vertical.Solid">

            <LinearLayout style="@style/Widget.Row.Primary">

                <TextClock
                    android:id="@+id/date"
                    style="@style/Widget.Date.Solid" />

                <TextView
                    android:id="@+id/alarm"
                    style="@style/Widget.Event.Solid" />

                <TextView
                    android:id="@+id/birthday"
                    style="@style/Widget.Event.Solid" />

            </LinearLayout>

            <TextView
                android:id="@+id/weather_aux"
                style="@style/Widget.Aux.Solid" />

        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Container.Weather.Solid"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/weather_icon"
                style="@style/Widget.WeatherIcon.Solid"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/weather_temp"
                style="@style/Widget.Temp.Solid" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
