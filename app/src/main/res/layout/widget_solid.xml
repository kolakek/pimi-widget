<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container.Solid">

    <LinearLayout style="@style/Widget.Container.Inner.Vertical.Solid">

        <LinearLayout style="@style/Widget.Row.Primary">

            <TextClock
                android:id="@+id/widget_date"
                style="@style/Widget.Date.Solid" />

            <TextView
                android:id="@+id/widget_alarm"
                style="@style/Widget.Event.Solid" />

            <TextView
                android:id="@+id/widget_birthday"
                style="@style/Widget.Event.Solid" />

        </LinearLayout>

        <TextView
            android:id="@+id/widget_weather_aux"
            style="@style/Widget.Aux.Solid" />

    </LinearLayout>

    <LinearLayout
        style="@style/Widget.Container.Weather.Solid"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/widget_weather_icon"
            style="@style/Widget.WeatherIcon.Solid"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/widget_weather_temp"
            style="@style/Widget.Temp.Solid" />

    </LinearLayout>

</LinearLayout>
