<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container">

    <LinearLayout style="@style/Widget.Row.Primary">

        <TextClock
            android:id="@+id/widget_date"
            style="@style/Widget.Date.Modern.Shadow" />

        <ImageView
            android:id="@+id/widget_weather_icon"
            style="@style/Widget.WeatherIcon"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/widget_weather_temp"
            style="@style/Widget.Temp.Modern.Shadow" />

        <TextView
            android:id="@+id/widget_alarm"
            style="@style/Widget.Event.Modern.Shadow" />

        <TextView
            android:id="@+id/widget_birthday"
            style="@style/Widget.Event.Modern.Shadow" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_weather_aux"
        style="@style/Widget.Aux.Modern.Shadow" />

</LinearLayout>
