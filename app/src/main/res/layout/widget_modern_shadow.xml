<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.VerticalContainer">

    <LinearLayout style="@style/Widget.PrimaryRowModern">

        <TextClock
            android:id="@+id/widget_date"
            style="@style/Widget.DateModernShadow" />

        <ImageView
            android:id="@+id/widget_weather_icon"
            style="@style/Widget.WeatherIcon"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/widget_weather_temp"
            style="@style/Widget.TempModernShadow" />

        <TextView
            android:id="@+id/widget_alarm"
            style="@style/Widget.EventModernShadow" />

        <TextView
            android:id="@+id/widget_birthday"
            style="@style/Widget.EventModernShadow" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_weather_aux"
        style="@style/Widget.AuxModernShadow" />

</LinearLayout>
