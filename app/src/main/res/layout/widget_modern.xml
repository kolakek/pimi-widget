<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    style="@style/Widget.Container">

    <LinearLayout style="@style/Widget.Row.Primary">

        <TextClock
            android:id="@+id/widget_date_text"
            style="@style/Widget.Date.Modern"
            tools:ignore="TextContrastCheck" />

        <LinearLayout
            android:id="@+id/widget_weather"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_sync_icon"
                android:contentDescription="@string/widget_sync_desc"
                android:src="@drawable/ic_sync"
                style="@style/Widget.SyncIcon.Modern" />

            <ImageView
                android:id="@+id/widget_weather_icon"
                tools:ignore="ContentDescription"
                style="@style/Widget.WeatherIcon" />

            <TextView
                android:id="@+id/widget_temp_text"
                style="@style/Widget.Temp.Modern" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_alarm"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_alarm_icon"
                android:contentDescription="@string/widget_alarm_desc"
                android:src="@drawable/ic_alarm"
                style="@style/Widget.EventIcon" />

            <TextView
                android:id="@+id/widget_alarm_text"
                style="@style/Widget.Event" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_birthday"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_birthday_icon"
                android:contentDescription="@string/widget_birthday_desc"
                android:src="@drawable/ic_birthday"
                style="@style/Widget.EventIcon" />

            <TextView
                android:id="@+id/widget_birthday_text"
                style="@style/Widget.Event" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout style="@style/Widget.Row.Primary">

        <LinearLayout
            android:id="@+id/widget_aux"
            style="@style/Widget.Container.Inner.Horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_warn_svr_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warn_sevr"
                style="@style/Widget.WarnIcon.Modern" />

            <ImageView
                android:id="@+id/widget_warn_xtr_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warn_extr"
                style="@style/Widget.WarnIcon.Modern" />

            <TextView
                android:id="@+id/widget_aux_text"
                style="@style/Widget.Aux.Modern" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
