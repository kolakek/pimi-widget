<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Config.Coordinator" parent="">
        <item name="android:background">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Config.AppBar" parent="">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="liftOnScrollColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Config.MaterialDialogAlert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:colorBackground">?attr/colorSurfaceBright</item>
    </style>

    <style name="App.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="App.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="backgroundTint">@color/toggle_button</item>
        <item name="strokeColor">?attr/colorSecondaryContainer</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="App.PlaceBarText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Base" parent="android:Widget">
        <item name="android:background">#00000000</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.Container" parent="Widget.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Container.Inner" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Container.Inner.Horizontal" parent="Widget.Container.Inner">
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.Container.Inner.Vertical" parent="Widget.Container.Inner">
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Row" parent="Widget.Container.Inner.Horizontal">
        <item name="android:layout_marginVertical">2dp</item>
    </style>

    <style name="Widget.Row.Primary" parent="Widget.Row">
        <item name="android:minHeight">24dp</item>
    </style>

    <style name="Widget.Text" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.Text.Primary" parent="Widget.Text">
        <item name="android:textSize">@dimen/widget_text_size_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Text.Secondary" parent="Widget.Text">
        <item name="android:textSize">@dimen/widget_text_size_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.WeatherIcon" parent="Widget.Base">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="Widget.Date" parent="Widget.Text.Primary">
        <item name="android:format12Hour">@string/widget_date_format</item>
        <item name="android:format24Hour">@string/widget_date_format</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="Widget.Date.Modern" parent="Widget.Date">
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <style name="Widget.Event" parent="Widget.Text.Primary">
        <item name="android:drawablePadding">2dp</item>
    </style>

    <style name="Widget.Temp.Classic" parent="Widget.Text.Secondary">
        <item name="android:paddingStart">4dp</item>
    </style>

    <style name="Widget.Temp.Modern" parent="Widget.Text.Primary">
        <item name="android:paddingStart">4dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <style name="Widget.Aux.Classic" parent="Widget.Text.Secondary">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="Widget.Aux.Modern" parent="Widget.Text">
        <item name="android:textSize">@dimen/widget_text_size_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginVertical">6dp</item>
    </style>

    <style name="TextAppearance.Widget.Shadow" parent="">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.Date.Shadow" parent="Widget.Date">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Date.Modern.Shadow" parent="Widget.Date.Modern">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Event.Shadow" parent="Widget.Event">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Temp.Classic.Shadow" parent="Widget.Temp.Classic">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Temp.Modern.Shadow" parent="Widget.Temp.Modern">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Aux.Classic.Shadow" parent="Widget.Aux.Classic">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Aux.Modern.Shadow" parent="Widget.Aux.Modern">
        <item name="android:textAppearance">@style/TextAppearance.Widget.Shadow</item>
    </style>

    <style name="Widget.Container.Solid" parent="Widget.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="Widget.Container.Solid.Frame" parent="Widget.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">8dp</item>
    </style>

    <style name="Widget.Container.Inner.Vertical.Solid" parent="Widget.Container.Inner.Vertical">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.Container.Weather.Solid" parent="Widget.Base">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/widget_icon_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.Background.Solid" parent="Widget.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:src">@drawable/widget_background</item>
    </style>

    <style name="Widget.WeatherIcon.Solid" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.Date.Solid" parent="Widget.Date">
        <item name="android:textColor">@color/dynamic_text_color</item>
    </style>

    <style name="Widget.Event.Solid" parent="Widget.Event">
        <item name="android:textColor">@color/dynamic_text_color</item>
    </style>

    <style name="Widget.Temp.Solid" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dynamic_temp_color</item>
        <item name="android:textSize" tools:ignore="SpUsage">14dp</item>
    </style>

    <style name="Widget.Aux.Solid" parent="Widget.Text">
        <item name="android:textSize">@dimen/widget_text_size_medium</item>
        <item name="android:textColor">@color/dynamic_text_color</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

</resources>
