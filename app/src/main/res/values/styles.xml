<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Config.Coordinator" parent="">
        <item name="android:background">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Config.AppBar" parent="">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="liftOnScrollColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Config.MaterialDialogAlert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:colorBackground">?attr/colorSurfaceBright</item>
    </style>

    <style name="App.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="App.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="backgroundTint">@color/toggle_button</item>
        <item name="strokeColor">?attr/colorSecondaryContainer</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="App.PlaceBarText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.Base" parent="android:Widget">
        <item name="android:background">#00000000</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.VerticalContainer" parent="Widget.Base">
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.InnerHorizontalContainer" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.InnerVerticalContainer" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.InnerView" parent="Widget.Base">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.PrimaryText" parent="Widget.InnerView">
        <item name="android:textSize">@dimen/widget_text_size_large</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.SecondaryText" parent="Widget.InnerView">
        <item name="android:textSize">@dimen/widget_text_size_medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.WeatherIcon" parent="Widget.Base">
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_width">24dp</item>
    </style>

    <style name="Widget.PrimaryRowClassic" parent="Widget.InnerHorizontalContainer">
        <item name="android:layout_marginVertical">2dp</item>
        <item name="android:minHeight">24dp</item>
    </style>

    <style name="Widget.DateClassic" parent="Widget.PrimaryText">
        <item name="android:format12Hour">@string/widget_date_format</item>
        <item name="android:format24Hour">@string/widget_date_format</item>
        <item name="android:layout_marginRight">12dp</item>
    </style>

    <style name="Widget.EventClassic" parent="Widget.PrimaryText">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="Widget.DateClassicShadow" parent="Widget.DateClassic">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.EventClassicShadow" parent="Widget.EventClassic">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.SecondaryRowClassic" parent="Widget.InnerHorizontalContainer">
        <item name="android:layout_marginVertical">2dp</item>
    </style>

    <style name="Widget.TempClassic" parent="Widget.SecondaryText">
        <item name="android:paddingLeft">4dp</item>
    </style>

    <style name="Widget.TempClassicShadow" parent="Widget.TempClassic">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.AuxClassic" parent="Widget.SecondaryText">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="Widget.AuxClassicShadow" parent="Widget.AuxClassic">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.PrimaryRowModern" parent="Widget.InnerHorizontalContainer">
        <item name="android:layout_marginVertical">2dp</item>
    </style>

    <style name="Widget.DateModern" parent="Widget.PrimaryText">
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:format12Hour">@string/widget_date_format</item>
        <item name="android:format24Hour">@string/widget_date_format</item>
    </style>

    <style name="Widget.TempModern" parent="Widget.PrimaryText">
        <item name="android:paddingLeft">4dp</item>
        <item name="android:layout_marginRight">14dp</item>
    </style>

    <style name="Widget.EventModern" parent="Widget.PrimaryText">
        <item name="android:drawablePadding">2dp</item>
    </style>

    <style name="Widget.AuxModern" parent="Widget.InnerView">
        <item name="android:textSize">@dimen/widget_text_size_small</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.DateModernShadow" parent="Widget.DateModern">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.TempModernShadow" parent="Widget.TempModern">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.EventModernShadow" parent="Widget.EventModern">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.AuxModernShadow" parent="Widget.AuxModern">
        <item name="android:shadowColor">#222222</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Widget.HorizontalContainerSolid" parent="Widget.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/widget_background</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="Widget.InnerVerticalContainerSolid" parent="Widget.InnerVerticalContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.WeatherContainerSolid" parent="Widget.Base">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_width">60dp</item>
        <item name="android:background">@drawable/widget_icon_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="Widget.WeatherIconSolid" parent="Widget.Base">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="Widget.TempSolid" parent="Widget.Base">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dynamic_temp_color</item>
        <item name="android:textSize" tools:ignore="SpUsage">14dp</item>
    </style>

    <style name="Widget.PrimaryRowSolid" parent="Widget.InnerHorizontalContainer">
        <item name="android:layout_marginVertical">2dp</item>
        <item name="android:minHeight">24dp</item>
    </style>

    <style name="Widget.PrimaryTextSolid" parent="Widget.PrimaryText">
        <item name="android:textColor">@color/dynamic_text_color</item>
    </style>

    <style name="Widget.DateSolid" parent="Widget.PrimaryTextSolid">
        <item name="android:format12Hour">@string/widget_date_format</item>
        <item name="android:format24Hour">@string/widget_date_format</item>
        <item name="android:layout_marginRight">12dp</item>
    </style>

    <style name="Widget.EventSolid" parent="Widget.PrimaryTextSolid">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="Widget.AuxSolid" parent="Widget.InnerView">
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textColor">@color/dynamic_text_color</item>
        <item name="android:textSize">@dimen/widget_text_size_medium</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

</resources>
